# ─── WhatsApp Cloud API ─────────────────────────────────────────────────────
# From Meta Business → WhatsApp → API setup
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# Webhook verify token — pick any string; you'll paste it into Meta's webhook config
VERIFY_TOKEN=playfactory-verify
# App secret from Meta App settings — used to verify X-Hub-Signature-256
META_APP_SECRET=

# ─── Flow encryption (after you generate the keypair) ───────────────────────
# Paste the private key PEM block (or set FLOW_PRIVATE_KEY_FILE to a path).
FLOW_PRIVATE_KEY=
FLOW_PASSPHRASE=
# Once you upload the flow to Meta, paste its ID here
FLOW_ID_BOOKING=

# ─── Sheets backend (same as web/.env.local) ────────────────────────────────
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# ─── Reminder cron auth (Vercel Cron / external scheduler) ──────────────────
CRON_SECRET=

# ─── Owner / business ───────────────────────────────────────────────────────
ADMIN_PHONE=919876543210
BUSINESS_NAME=PlayFactory
WEBSITE_URL=https://playfactory.in
