# ─── Supabase ────────────────────────────────────────────────────────────────
# From Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
# service_role bypasses RLS — server-side only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ─── Apps Script email worker ────────────────────────────────────────────────
# Apps Script Web App URL (the /exec URL after deploying apps-script/Code.gs)
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_ME/exec
# Shared secret — must match SECRET in apps-script/Code.gs
SHEETS_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# ─── Owner / public ──────────────────────────────────────────────────────────
# The email that gets owner-dashboard access at /admin (must match the email
# the owner signs up with on the website).
ADMIN_EMAIL=owner@playfactory.in

# Public WhatsApp number for the floating "Chat on WhatsApp" button
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
